// Função global para trocar de abas
function switchTab(tabId) {
  // Oculta todas as seções
  const sections = document.querySelectorAll('.view-section');
  sections.forEach(sec => sec.classList.remove('active'));

  // Remove destaque dos botões da barra inferior
  const buttons = document.querySelectorAll('.nav-item');
  buttons.forEach(btn => btn.classList.remove('active'));

  // Ativa a seção solicitada
  const targetSection = document.getElementById('sec-' + tabId);
  if (targetSection) {
    targetSection.classList.add('active');
  }

  // Ativa o botão correspondente na barra inferior
  const targetBtn = document.getElementById('nav-' + (tabId === 'dashboard' ? 'dash' : tabId));
  if (targetBtn) {
    targetBtn.classList.add('active');
  }
}

// Inicialização da data e primeira aba ao carregar a página
document.addEventListener('DOMContentLoaded', () => {
  const dateEl = document.getElementById('current-date-display');
  if (dateEl) {
    const hoje = new Date();
    dateEl.textContent = hoje.toLocaleDateString('pt-BR');
  }
  
  // Força abertura do dashboard na inicialização
  switchTab('dashboard');
});
