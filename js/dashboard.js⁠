// Função para carregar dados já salvos no formulário ao abrir a aba
function carregarValoresRegistro() {
  const p = localStorage.getItem('reg_peso') || '';
  const c = localStorage.getItem('reg_cintura') || '';
  const pt = localStorage.getItem('reg_panturrilha') || '';
  const aguaTotal = localStorage.getItem('reg_agua') || '0';

  if (document.getElementById('reg-peso')) document.getElementById('reg-peso').value = p;
  if (document.getElementById('reg-cintura')) document.getElementById('reg-cintura').value = c;
  if (document.getElementById('reg-panturrilha')) document.getElementById('reg-panturrilha').value = pt;
  if (document.getElementById('total-agua-exibicao')) document.getElementById('total-agua-exibicao').innerText = aguaTotal;
}

// Função executada ao clicar no botão "Salvar Registro"
function salvarRegistroCompleto(event) {
  event.preventDefault();

  const peso = document.getElementById('reg-peso').value;
  const cintura = document.getElementById('reg-cintura').value;
  const panturrilha = document.getElementById('reg-panturrilha').value;
  const aguaAddInput = document.getElementById('reg-agua-add');
  
  // Salva Peso e Medidas
  if (peso) localStorage.setItem('reg_peso', peso);
  if (cintura) localStorage.setItem('reg_cintura', cintura);
  if (panturrilha) localStorage.setItem('reg_panturrilha', panturrilha);

  // Soma a Água Digitada ao Total
  const valorAguaAdd = parseInt(aguaAddInput.value);
  if (!isNaN(valorAguaAdd) && valorAguaAdd > 0) {
    const aguaAtual = parseInt(localStorage.getItem('reg_agua') || '0');
    const novoTotalAgua = aguaAtual + valorAguaAdd;
    localStorage.setItem('reg_agua', novoTotalAgua);
    document.getElementById('total-agua-exibicao').innerText = novoTotalAgua;
    aguaAddInput.value = ''; // Limpa a caixa de digitação da água
  }

  alert('Registro salvo com sucesso!');
}

function zerarAguaTotal() {
  localStorage.setItem('reg_agua', 0);
  if (document.getElementById('total-agua-exibicao')) document.getElementById('total-agua-exibicao').innerText = '0';
}

document.addEventListener('DOMContentLoaded', carregarValoresRegistro);
