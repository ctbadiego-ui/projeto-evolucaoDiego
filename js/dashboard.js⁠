// ==========================================
// FUNÇÕES DE ÁGUA (ESCOPO GLOBAL)
// ==========================================
window.adicionarAgua = function(qtdMl) {
  const valorDigitado = parseInt(qtdMl);
  if (isNaN(valorDigitado) || valorDigitado <= 0) return;

  const aguaAtual = parseInt(localStorage.getItem('reg_agua') || '0');
  const novoTotal = aguaAtual + valorDigitado;
  
  localStorage.setItem('reg_agua', novoTotal);
  renderAbaRegistro();
};

window.resetarAgua = function() {
  localStorage.setItem('reg_agua', 0);
  renderAbaRegistro();
};

// ==========================================
// RENDERIZAÇÃO DA ABA REGISTRAR DADOS
// ==========================================
function renderAbaRegistro() {
  const containerRegistro = document.getElementById('secao-registro');
  if (!containerRegistro) return;

  const pesoSalvo = localStorage.getItem('reg_peso') || '';
  const cinturaSalva = localStorage.getItem('reg_cintura') || '';
  const panturrilhaSalva = localStorage.getItem('reg_panturrilha') || '';
  const aguaAcumulada = localStorage.getItem('reg_agua') || '0';

  containerRegistro.innerHTML = `
    <h2 style="font-size: 1.1rem; color: #f8fafc; margin-bottom: 16px;">Registrar Dados de Hoje</h2>
    
    <div style="display: flex; flex-direction: column; gap: 12px; background: #0f172a; padding: 16px; border-radius: 8px; border: 1px solid #334155;">
      
      <!-- Peso -->
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 8px;">
        <span style="font-size: 0.9rem; color: #94a3b8; font-weight: 500;">⚖️ Peso Corporal</span>
        <div style="display: flex; align-items: center; gap: 6px;">
          <input type="number" id="input-peso" step="0.1" placeholder="0.0" value="${pesoSalvo}"
                 onchange="localStorage.setItem('reg_peso', this.value)"
                 style="width: 75px; padding: 6px 8px; background: #1e293b; border: 1px solid #475569; color: #38bdf8; font-weight: bold; border-radius: 6px; text-align: center;">
          <span style="font-size: 0.85rem; color: #64748b;">kg</span>
        </div>
      </div>

      <!-- Cintura -->
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 8px;">
        <span style="font-size: 0.9rem; color: #94a3b8; font-weight: 500;">📏 Cintura</span>
        <div style="display: flex; align-items: center; gap: 6px;">
          <input type="number" id="input-cintura" step="0.5" placeholder="0.0" value="${cinturaSalva}"
                 onchange="localStorage.setItem('reg_cintura', this.value)"
                 style="width: 75px; padding: 6px 8px; background: #1e293b; border: 1px solid #475569; color: #38bdf8; font-weight: bold; border-radius: 6px; text-align: center;">
          <span style="font-size: 0.85rem; color: #64748b;">cm</span>
        </div>
      </div>

      <!-- Panturrilha -->
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 8px;">
        <span style="font-size: 0.9rem; color: #94a3b8; font-weight: 500;">🦵 Panturrilha</span>
        <div style="display: flex; align-items: center; gap: 6px;">
          <input type="number" id="input-panturrilha" step="0.5" placeholder="0.0" value="${panturrilhaSalva}"
                 onchange="localStorage.setItem('reg_panturrilha', this.value)"
                 style="width: 75px; padding: 6px 8px; background: #1e293b; border: 1px solid #475569; color: #38bdf8; font-weight: bold; border-radius: 6px; text-align: center;">
          <span style="font-size: 0.85rem; color: #64748b;">cm</span>
        </div>
      </div>

      <!-- Água Acumulada -->
      <div style="display: flex; flex-direction: column; gap: 8px; padding-top: 4px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.9rem; color: #94a3b8; font-weight: 500;">💧 Água Acumulada</span>
          <strong style="font-size: 1rem; color: #38bdf8;">${aguaAcumulada} ml</strong>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
          <input type="number" id="input-add-agua" step="50" placeholder="+ ml (ex: 250)" 
                 style="flex: 1; padding: 6px 8px; background: #1e293b; border: 1px solid #475569; color: #f8fafc; border-radius: 6px; text-align: center;">
          
          <button onclick="window.adicionarAgua(document.getElementById('input-add-agua').value)"
                  style="padding: 6px 12px; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">
            + Somar
          </button>
          
          <button onclick="window.resetarAgua()" title="Zerar água de hoje"
                  style="padding: 6px 10px; background: #334155; color: #94a3b8; border: none; border-radius: 6px; font-size: 0.8rem; cursor: pointer;">
            🔄
          </button>
        </div>
      </div>

    </div>
  `;
}

document.addEventListener('DOMContentLoaded', renderAbaRegistro);
