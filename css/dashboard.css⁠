.metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
.metric-box { background: #0f172a; padding: 12px; border-radius: 8px; border: 1px solid #334155; }
.metric-box .label { display: block; color: #94a3b8; font-size: 0.75rem; }
.metric-box .value { font-size: 1.1rem; font-weight: bold; color: #f8fafc; margin-top: 4px; display: block; }
.metric-box.highlighted { border-color: #38bdf8; }
.progress-container { margin-top: 15px; }
.progress-label { display: flex; justify-content: space-between; font-size: 0.8rem; color: #94a3b8; margin-bottom: 5px; }
.progress-bar-bg { background: #0f172a; height: 8px; border-radius: 4px; overflow: hidden; }
.progress-bar-fill { background: #38bdf8; height: 100%; transition: width 0.3s; }
.quick-nav-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px; }
.nav-card-btn { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 15px 5px; color: #f8fafc; display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; }
