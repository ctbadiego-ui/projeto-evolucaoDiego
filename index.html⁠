<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Projeto Evolução</title>
  
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #0f172a; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding-bottom: 80px; }
    .app-header { background: #1e293b; padding: 15px 20px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
    .app-header h1 { color: #38bdf8; font-size: 1.2rem; }
    .date-display { color: #94a3b8; font-size: 0.85rem; }
    .app-body { padding: 15px; }
    .card { background: #1e293b; border-radius: 12px; padding: 15px; margin-bottom: 15px; border: 1px solid #334155; }
    
    /* Controle de Visibilidade das Seções */
    .view-section { display: none !important; }
    .view-section.active { display: block !important; }
    
    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
    .metric-box { background: #0f172a; padding: 12px; border-radius: 8px; border: 1px solid #334155; }
    .metric-box .label { display: block; color: #94a3b8; font-size: 0.75rem; }
    .metric-box .value { font-size: 1.1rem; font-weight: bold; color: #f8fafc; margin-top: 4px; display: block; }
    .metric-box.highlighted { border-color: #38bdf8; }
    .progress-container { margin-top: 15px; }
    .progress-label { display: flex; justify-content: space-between; font-size: 0.8rem; color: #94a3b8; margin-bottom: 5px; }
    .progress-bar-bg { background: #0f172a; height: 8px; border-radius: 4px; overflow: hidden; }
    .progress-bar-fill { background: #38bdf8; height: 100%; transition: width 0.3s; }
    .quick-nav-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px; }
    .nav-card-btn { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 15px 5px; color: #f8fafc; display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; }
    .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: #0f172a; border-top: 1px solid #334155; display: flex; justify-content: space-around; padding: 8px 0; z-index: 999; }
    .nav-item { background: none; border: none; color: #64748b; font-size: 0.75rem; display: flex; flex-direction: column; align-items: center; cursor: pointer; }
    .nav-item.active { color: #38bdf8; }
    .nav-item .icon { font-size: 1.2rem; }
  </style>
</head>
<body>
  <header class="app-header">
    <div class="header-content">
      <h1>Projeto Evolução</h1>
      <span class="date-display" id="current-date-display">--/--/----</span>
    </div>
  </header>

  <main class="app-body">
    <!-- Section: Dashboard -->
    <section id="sec-dashboard" class="view-section active">
      <div class="card summary-card">
        <h2 style="color: #f8fafc; font-size: 1.1rem;">Resumo de Hoje</h2>
        <div class="metrics-grid">
          <div class="metric-box"><span class="label">Peso</span><span class="value" id="dash-peso">-- kg</span></div>
          <div class="metric-box"><span class="label">Cintura</span><span class="value" id="dash-cintura">-- cm</span></div>
          <div class="metric-box"><span class="label">Panturrilha</span><span class="value" id="dash-panturrilha">-- cm</span></div>
          <div class="metric-box highlighted"><span class="label">Proteína</span><span class="value" id="dash-proteina">0g / 160g</span></div>
        </div>
        <div class="progress-container">
          <div class="progress-label"><span>Água Consumida</span><span id="dash-agua-val">0 / 3000 ml</span></div>
          <div class="progress-bar-bg"><div class="progress-bar-fill" id="dash-agua-bar" style="width: 30%;"></div></div>
        </div>
      </div>

      <div class="quick-nav-grid">
        <button class="nav-card-btn" onclick="switchTab('registrar')"><span class="icon">📝</span><span class="title">Registrar</span></button>
        <button class="nav-card-btn" onclick="switchTab('dieta')"><span class="icon">🍽️</span><span class="title">Dieta</span></button>
        <button class="nav-card-btn" onclick="switchTab('treino')"><span class="icon">🏋️</span><span class="title">Treino</span></button>
      </div>
    </section>

    <!-- Section: Registrar -->
    <section id="sec-registrar" class="view-section">
      <div class="card">
        <h2 style="color: #f8fafc; font-size: 1.1rem; margin-bottom: 10px;">Registrar Dados de Hoje</h2>
        <p style="color: #94a3b8; font-size: 0.9rem;">Formulário de registro em breve.</p>
      </div>
    </section>
  </main>

  <!-- Navegação Inferior -->
  <nav class="bottom-nav">
    <button class="nav-item active" id="nav-dash" onclick="switchTab('dashboard')"><span class="icon">🏠</span><span class="label">Início</span></button>
    <button class="nav-item" id="nav-reg" onclick="switchTab('registrar')"><span class="icon">📝</span><span class="label">Registrar</span></button>
  </nav>

  <script>
    function switchTab(tabId) {
      // Oculta todas as seções
      const sections = document.querySelectorAll('.view-section');
      sections.forEach(sec => sec.classList.remove('active'));

      // Remove destaque dos botões
      const buttons = document.querySelectorAll('.nav-item');
      buttons.forEach(btn => btn.classList.remove('active'));

      // Ativa a seção selecionada
      const targetSection = document.getElementById('sec-' + tabId);
      if (targetSection) {
        targetSection.classList.add('active');
      }

      // Destaca o botão selecionado
      const targetBtn = document.getElementById('nav-' + (tabId === 'dashboard' ? 'dash' : 'reg'));
      if (targetBtn) {
        targetBtn.classList.add('active');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Atualiza data atual
      const dateEl = document.getElementById('current-date-display');
      if (dateEl) {
        const hoje = new Date();
        dateEl.textContent = hoje.toLocaleDateString('pt-BR');
      }
      // Garante exibição do dashboard na abertura
      switchTab('dashboard');
    });
  </script>
</body>
</html>
