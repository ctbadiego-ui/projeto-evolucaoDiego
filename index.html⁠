<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Projeto Evolução</title>
  
  <!-- Estilos CSS do Projeto -->
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/dashboard.css">
  <link rel="stylesheet" href="css/charts.css">
</head>
<body>
  <header class="app-header">
    <div class="header-content">
      <h1>Projeto Evolução</h1>
      <span class="date-display" id="current-date-display">24/08/2026</span>
    </div>
  </header>

  <main class="app-body">
    <section id="sec-dashboard" class="view-section active">
      <div class="card summary-card">
        <h2>Resumo de Hoje</h2>
        <div class="metrics-grid">
          <div class="metric-box"><span class="label">Peso</span><span class="value" id="dash-peso">-- kg</span></div>
          <div class="metric-box"><span class="label">Cintura</span><span class="value" id="dash-cintura">-- cm</span></div>
          <div class="metric-box"><span class="label">Panturrilha</span><span class="value" id="dash-panturrilha">-- cm</span></div>
          <div class="metric-box highlighted"><span class="label">Proteína</span><span class="value" id="dash-proteina">0g / 160g</span></div>
        </div>
      </div>
    </section>
  </main>

  <!-- Carregamento individual com tratamento de erro em cada Script -->
  <script src="js/storage.js" defer></script>
  <script src="js/dashboard.js" defer></script>
  <script src="js/app.js" defer></script>
</body>
</html>
