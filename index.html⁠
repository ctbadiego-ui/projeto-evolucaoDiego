<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Projeto Evolução</title>
  <link rel="manifest" href="manifest.webmanifest">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Evolução">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/dashboard.css">
  <link rel="stylesheet" href="css/charts.css">
</head>
<body>
  <header class="app-header">
    <div class="header-content">
      <h1>Projeto Evolução</h1>
      <span class="date-display" id="current-date-display">--/--/----</span>
    </div>
  </header>

  <main class="app-body">
    <section id="sec-dashboard" class="view-section active">
      <div class="card summary-card">
        <h2>Resumo de Hoje</h2>
        <div class="metrics-grid">
          <div class="metric-box"><span class="label">Peso</span><span class="value" id="dash-peso">-- kg</span></div>
          <div class="metric-box"><span class="label">Cintura</span><span class="value" id="dash-cintura">-- cm</span></div>
          <div class="metric-box"><span class="label">Panturrilha</span><span class="value" id="dash-panturrilha">-- cm</span></div>
          <div class="metric-box highlighted"><span class="label">Proteína</span><span class="value" id="dash-proteina">0g / 160g</span></div>
        </div>
        <div class="progress-container">
          <div class="progress-label"><span>Água Consumida</span><span id="dash-agua-val">0 / 3000 ml</span></div>
          <div class="progress-bar-bg"><div class="progress-bar-fill" id="dash-agua-bar" style="width: 0%;"></div></div>
        </div>
        <div class="today-workout-badge"><span>Treino de Hoje:</span><strong id="dash-treino-nome">Carregando...</strong></div>
      </div>

      <div class="quick-nav-grid">
        <button class="nav-card-btn" onclick="switchTab('registrar')"><span class="icon">📝</span><span class="title">Registrar</span></button>
        <button class="nav-card-btn" onclick="switchTab('dieta')"><span class="icon">🍽️</span><span class="title">Dieta</span></button>
        <button class="nav-card-btn" onclick="switchTab('treino')"><span class="icon">🏋️</span><span class="title">Treino</span></button>
        <button class="nav-card-btn" onclick="switchTab('checklist')"><span class="icon">☑️</span><span class="title">Checklist</span></button>
        <button class="nav-card-btn" onclick="switchTab('evolucao')"><span class="icon">📊</span><span class="title">Evolução</span></button>
        <button class="nav-card-btn" onclick="switchTab('graficos')"><span class="icon">📈</span><span class="title">Gráficos</span></button>
      </div>
    </section>

    <section id="sec-registrar" class="view-section">
      <div class="card">
        <h2>Registrar Dados de Hoje</h2>
        <form id="form-registro" onsubmit="saveRegistroHoje(event)">
          <div class="form-group-title">Medidas Corporais</div>
          <div class="form-row">
            <div class="form-group"><label>Peso (kg)</label><input type="number" step="0.1" id="input-peso" placeholder="Ex: 75.5"></div>
            <div class="form-group"><label>Cintura (cm)</label><input type="number" step="0.1" id="input-cintura" placeholder="Ex: 82.0"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Panturrilha (cm)</label><input type="number" step="0.1" id="input-panturrilha" placeholder="Ex: 38.0"></div>
            <div class="form-group"><label>Água (ml)</label><input type="number" step="100" id="input-agua" placeholder="Ex: 2500"></div>
          </div>
          <div class="form-group-title">Cardio do Dia</div>
          <div class="form-row">
            <div class="form-group">
              <label>Tipo</label>
              <select id="input-cardio-tipo"><option value="Esteira">Esteira</option><option value="Bicicleta">Bicicleta</option><option value="Caminhada">Caminhada</option></select>
            </div>
            <div class="form-group"><label>Tempo (min)</label><input type="number" id="input-cardio-tempo" placeholder="Ex: 30"></div>
          </div>
          <div class="form-group"><label>Distância (km)</label><input type="number" step="0.01" id="input-cardio-dist" placeholder="Ex: 5.0"></div>
          <button type="submit" class="btn-primary">Salvar Registro</button>
        </form>
      </div>
    </section>

    <section id="sec-dieta" class="view-section">
      <div class="card">
        <h2>Plano de Alimentação</h2>
        <div class="macro-summary"><span>Proteína Total Consumida Hoje:</span><strong id="dieta-proteina-total">0g</strong></div>
        <div id="meals-container"></div>
      </div>
    </section>

    <section id="sec-treino" class="view-section">
      <div class="card">
        <div class="tab-header-select">
          <label>Dia da Semana:</label>
          <select id="select-dia-treino" onchange="renderTreino(this.value)">
            <option value="Segunda">Segunda - Parte Superior</option>
            <option value="Terca">Terça - Parte Inferior</option>
            <option value="Quarta">Quarta - Cardio</option>
            <option value="Quinta">Quinta - Superior + Abdômen</option>
            <option value="Sexta">Sexta - Inferior + Bicicleta</option>
          </select>
        </div>
        <h3 id="treino-titulo" class="workout-title">Treino</h3>
        <div id="exercises-list" class="checklist-group"></div>
      </div>
    </section>

    <section id="sec-checklist" class="view-section">
      <div class="card">
        <h2>Checklist Diário</h2>
        <p class="subtitle">Acompanhe seu cumprimento de metas hoje</p>
        <div id="checklist-items" class="checklist-group"></div>
      </div>
    </section>

    <section id="sec-evolucao" class="view-section">
      <div class="card">
        <h2>Histórico de Evolução</h2>
        <div class="table-responsive">
          <table class="data-table">
            <thead><tr><th>Data</th><th>Peso</th><th>Cintura</th><th>Panturrilha</th></tr></thead>
            <tbody id="historico-tbody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="sec-graficos" class="view-section">
      <div class="card">
        <h2>Gráfico de Evolução</h2>
        <div class="chart-container"><canvas id="mainChart"></canvas></div>
      </div>
    </section>
  </main>

  <nav class="bottom-nav">
    <button class="nav-item active" id="nav-dash" onclick="switchTab('dashboard')"><span class="icon">🏠</span><span class="label">Início</span></button>
    <button class="nav-item" id="nav-reg" onclick="switchTab('registrar')"><span class="icon">📝</span><span class="label">Registrar</span></button>
    <button class="nav-item" id="nav-diet" onclick="switchTab('dieta')"><span class="icon">🍽️</span><span class="label">Dieta</span></button>
    <button class="nav-item" id="nav-workout" onclick="switchTab('treino')"><span class="icon">🏋️</span><span class="label">Treino</span></button>
    <button class="nav-item" id="nav-more" onclick="switchTab('checklist')"><span class="icon">☑️</span><span class="label">Hábitos</span></button>
  </nav>

  <script src="js/storage.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/treino.js"></script>
  <script src="js/dieta.js"></script>
  <script src="js/checklist.js"></script>
  <script src="js/progresso.js"></script>
  <script src="js/panturrilha.js"></script>
  <script src="js/graficos.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
